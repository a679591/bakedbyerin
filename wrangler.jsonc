{
	// Baked by Erin — EmDash site on Cloudflare Workers (D1 + R2).
	//
	// Production (main branch):  `pnpm build && wrangler deploy`
	//   → https://bakedbyerin.com (+ www and shop.); zone must be on your Cloudflare account
	// Previews (any other branch): `CLOUDFLARE_ENV=preview pnpm build && wrangler versions upload`
	//   → https://<branch>-baked-by-erin-preview.<account-subdomain>.workers.dev
	//   Separate Worker, D1 and R2 so previews never touch production orders.
	//
	// The Astro Cloudflare adapter flattens the selected env into dist/server/wrangler.json
	// at build time (selected via CLOUDFLARE_ENV), so don't pass `--env` to wrangler after building.
	"name": "baked-by-erin",
	"main": "./src/worker.ts",
	// "account_id": "YOUR_ACCOUNT_ID",  // optional; wrangler uses your logged-in account
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],

	// Astro Cloudflare build output (server + assets).
	"assets": { "directory": "./dist" },

	// bakedbyerin.com is the main site; www and the old shop. subdomain keep working.
	// Before the first deploy with these routes, remove bakedbyerin.com and www from the
	// old "bakedbyerin" Pages project (Custom domains) or the deploy will fail.
	"routes": [
		{ "pattern": "bakedbyerin.com", "custom_domain": true },
		{ "pattern": "www.bakedbyerin.com", "custom_domain": true },
		{ "pattern": "shop.bakedbyerin.com", "custom_domain": true }
	],
	"workers_dev": false,
	"preview_urls": false,

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "baked-by-erin",
			"database_id": "81ea2a8b-650c-4a0a-9687-42d9e2ea54de"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "baked-by-erin-media"
		}
	],
	// Astro session storage (logins). ID filled in by setup.ps1.
	"kv_namespaces": [{ "binding": "SESSION", "id": "3444a094a9614deaa53c2bbaaad68326" }],
	// EMDASH_ALLOWED_ORIGINS lets passkeys (made for bakedbyerin.com) also work on www. and shop.
	"vars": {
		"EMDASH_SITE_URL": "https://bakedbyerin.com",
		"EMDASH_ALLOWED_ORIGINS": "https://www.bakedbyerin.com,https://shop.bakedbyerin.com"
	},

	// Scheduled publishing + maintenance sweep (1/min).
	"triggers": { "crons": ["* * * * *"] },

	// Worker Loader binding — runs the sandboxed catalog-manager plugin in an
	// isolated isolate. Requires a Workers paid plan, so it is off for now.
	// Off on the Workers free plan. To enable the Catalog admin page (needs Workers Paid), uncomment:
	// "worker_loaders": [{ "binding": "LOADER" }],

	"env": {
		// Bindings/vars/routes are not inherited by envs, so they're all restated here.
		"preview": {
			"name": "baked-by-erin-preview",
			"routes": [],
			"workers_dev": true,
			"preview_urls": true,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "baked-by-erin-preview",
					"database_id": "df9696f0-d109-4eae-b5ea-583468f11541"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "baked-by-erin-preview-media"
				}
			],
			"kv_namespaces": [{ "binding": "SESSION", "id": "a839d6f244d64a928d5a6a1bc45ee5ed" }],
			"vars": {},
			"triggers": { "crons": ["* * * * *"] },
			// "worker_loaders": [{ "binding": "LOADER" }]
		}
	}
}
