				},
				{
					"type": "custom",
					"label": "Menu",
					"url": "/products"
				},
				{
					"type": "custom",
					"label": "Seasonal",
					"url": "/products?category=seasonal"
				},
				{
					"type": "custom",
					"label": "Passover",
					"url": "/products?category=passover"
				},
				{
					"type": "custom",
					"label": "Contact",
					"url": "/contact"
				}
			]
		}
	],
