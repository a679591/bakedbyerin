{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Baked by Erin",
		"description": "Handcrafted breads, cakes and treats from home baker Erin in Miami. Order ahead; pay after Erin confirms.",
		"author": "Baked by Erin"
	},
	"settings": {
		"title": "Baked by Erin",
		"tagline": "Handcrafted treats made with love for every occasion",
		"postsPerPage": 12
	},
	"collections": [
		{
			"slug": "products",
			"label": "Products",
			"labelSingular": "Product",
			"supports": [
				"drafts",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "summary",
					"label": "Summary",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "highlights",
					"label": "Highlights (one per line)",
					"type": "text"
				},
				{
					"slug": "mixins",
					"label": "Mix-ins: \"A, B\" = customer must pick one; \"optional: A\" = free add-on they can skip",
					"type": "string"
				},
				{
					"slug": "description",
					"label": "Description",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "price",
					"label": "Price (USD) — small size, or the only price",
					"type": "number",
					"required": true
				},
				{
					"slug": "price_large",
					"label": "Large size price (USD) — leave empty if one size only",
					"type": "number"
				},
				{
					"slug": "unit",
					"label": "Unit",
					"type": "select",
					"validation": {
						"options": [
							"loaf",
							"cake",
							"bag",
							"bottle",
							"box"
						],
						"default": "loaf"
					}
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "available",
					"label": "Available",
					"type": "boolean"
				},
				{
					"slug": "sort_order",
					"label": "Menu order (lower shows first)",
					"type": "integer"
				}
			]
		},
		{
			"slug": "orders",
			"label": "Orders",
			"labelSingular": "Order",
			"supports": [],
			"fields": [
				{
					"slug": "customer_name",
					"label": "Customer Name",
					"type": "string",
					"required": true
				},
				{
					"slug": "customer_email",
					"label": "Customer Email",
					"type": "string"
				},
				{
					"slug": "customer_phone",
					"label": "Customer Phone",
					"type": "string"
				},
				{
					"slug": "pickup_name",
					"label": "Pickup Name",
					"type": "string"
				},
				{
					"slug": "pickup_date",
					"label": "Requested date",
					"type": "datetime",
					"required": true
				},
				{
					"slug": "fulfillment",
					"label": "Pickup or delivery",
					"type": "select",
					"validation": {
						"options": [
							"pickup",
							"delivery"
						],
						"default": "pickup"
					}
				},
				{
					"slug": "delivery_address",
					"label": "Delivery address",
					"type": "text"
				},
				{
					"slug": "items",
					"label": "Items",
					"type": "repeater",
					"validation": {
						"subFields": [
							{
								"slug": "product",
								"label": "Product",
								"type": "string",
								"required": true
							},
							{
								"slug": "size",
								"label": "Size",
								"type": "string"
							},
							{
								"slug": "mixin",
								"label": "Mix-in",
								"type": "string"
							},
							{
								"slug": "quantity",
								"label": "Quantity",
								"type": "integer",
								"required": true
							},
							{
								"slug": "unit_price",
								"label": "Unit Price",
								"type": "number",
								"required": true
							}
						]
					}
				},
				{
					"slug": "delivery_fee",
					"label": "Delivery fee (USD)",
					"type": "number"
				},
				{
					"slug": "total",
					"label": "Total (USD)",
					"type": "number",
					"required": true
				},
				{
					"slug": "notes",
					"label": "Notes",
					"type": "text"
				},
				{
					"slug": "payment_method",
					"label": "Payment Method",
					"type": "select",
					"validation": {
						"options": [
							"pay-after-confirmation"
						],
						"default": "pay-after-confirmation"
					}
				},
				{
					"slug": "order_status",
					"label": "Order Status",
					"type": "select",
					"validation": {
						"options": [
							"new",
							"confirmed",
							"paid",
							"ready",
							"completed",
							"cancelled"
						],
						"default": "new"
					}
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": false,
			"collections": [
				"products"
			],
			"terms": [
				{
					"slug": "breads",
					"label": "Breads"
				},
				{
					"slug": "cakes",
					"label": "Cakes"
				},
				{
					"slug": "granola",
					"label": "Granola"
				},
				{
					"slug": "seasonal",
					"label": "Seasonal"
				},
				{
					"slug": "passover",
					"label": "Passover"
				}
			]
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{
					"type": "custom",
					"label": "Home",
